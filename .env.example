# ========================================================
# Whaticket Enterprise - Configuration
# Default environment configuration for Docker Compose
# ========================================================

NODE_ENV=production
TZ=America/Sao_Paulo

# --- Database (PostgreSQL) ---
DB_DIALECT=postgres
DB_HOST=whaticket_db
DB_PORT=5432
DB_USER=whaticket
DB_PASS=whaticket_secure_pass
DB_NAME=whaticket

# --- Redis Cache & Queues ---
REDIS_URI=redis://whaticket_redis:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

# --- Ports & Application URLs ---
PORT=3000
FRONTEND_PORT=3250
PROXY_PORT=8080
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3250
REACT_APP_BACKEND_URL=http://localhost:3000

# --- Security & JWT ---
JWT_SECRET=f3b18d29b2e2d93e2b2605c317a151b72e9a7e6b010c2c31e21b0e5d0a6c1e9f
JWT_REFRESH_SECRET=7b2c9d1a8e3f4b5a6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b
COOKIE_SECURE=false

# --- Limits & Behaviour ---
USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true
CHROME_ARGS=--no-sandbox,--disable-setuid-sandbox

# --- Company Branding ---
COMPANY_NAME=Whaticket

# --- Mail / SMTP (Opcional) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=suporte@example.com
MAIL_PASS=suporte_pass
MAIL_FROM="Whaticket <suporte@example.com>"

# --- Gerencianet / Payment Gateway (Opcional) ---
GERENCIANET_SANDBOX=true
GERENCIANET_CLIENT_ID=
GERENCIANET_CLIENT_SECRET=
GERENCIANET_PIX_CERT=
GERENCIANET_PIX_KEY=
